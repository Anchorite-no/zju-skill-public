# 字段参考，仅含空账号和非秘密默认值。不要创建明文密码文件。
# zju-skill 配置字段参考
# 请运行 node scripts/zju.ts profile init --system 系统名，在终端按提示输入。
# 只填写需要使用的系统；账号密码留空，不要把实际凭据写进本示例。
# 自动化程序可用 profile init --stdin 输入 JSON；不要把密码放在命令参数中。
# 同名环境变量优先，例如 ZJU_USERNAME / ZJU_PASSWORD。

# 浙大统一身份认证：教务、学在、体艺、智云使用
zju_username=
zju_password=

# WebVPN：访问校内系统时使用独立的校园网账号，不回退到统一认证凭据
webvpn_username=
webvpn_password=

# CC98：论坛独立账号
# 多账号继续添加 cc98_username_2 / cc98_password_2 等字段
cc98_username=
cc98_password=

# PTA：百腾通行证独立账号（邮箱），公网直连，不需要校园网或统一认证
pta_username=
pta_password=

# 超星学习通：手机号与密码，公网直连，不需要校园网或统一认证
chaoxing_username=
chaoxing_password=

# 浙大邮箱：完整 @zju.edu.cn 地址，和网页版「设置 → 安全设置 → 客户端专用密码」生成的 16 位密码；收信发信共用
mail_username=
mail_password=

# 校内站点默认经 WebVPN 访问；能直连校园网时可改为 direct
# 公网系统按各模块声明直连，不受该选项影响
transport=webvpn

# 实验课平台：独立密码；lab_username 留空时使用统一认证的学号
lab_username=
lab_password=

# 体艺场馆：校园卡查询密码；同伴账号须经同伴本人授权
tyys_card_password=
tyys_buddy_username=
tyys_buddy_password=
# 多位同伴继续添加 tyys_buddy_username_2 / tyys_buddy_password_2

# 学籍快捷项（可选），用于培养方案等查询
grade=
major_code=
major_name=

# 通知按学院和学生类别选来源（可选）。
# college：学院全称，如 计算机科学与技术学院。本科生留空时自动从教务网读取；研究生需要填写。
# student_level：本科 或 研究生。留空时按学号判断（3 开头本科，1、2 开头研究生）。
college=
student_level=
